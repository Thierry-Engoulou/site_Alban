# ==============================================================
# CONFIGURATION DE L'APPLICATION WEB HIGH QUALITY TÉLÉCOMS
# ==============================================================

# Port d'écoute du serveur web
PORT=3000
NODE_ENV=development

# --------------------------------------------------------------
# BASE DE DONNÉES
# Options: 'sqlite' (par défaut, sans installation externe requise)
#          'mysql'  (si vous utilisez une base MySQL / cPanel phpMyAdmin)
# --------------------------------------------------------------
DB_TYPE=sqlite

# PostgreSQL (Neon) : recommandé sur Vercel. Rempli automatiquement quand la base Neon
# est connectée au projet (Vercel → Storage). S'il est défini, il remplace DB_TYPE.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# Paramètres si DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456_hq
DB_PASSWORD=mot_de_passe_mysql
DB_NAME=highquality_telecoms

# --------------------------------------------------------------
# ADRESSE EMAIL PROFESSIONNELLE & SERVEUR SMTP
# Remplacez par les accès fournis par votre hébergeur pour le domaine
# --------------------------------------------------------------
SMTP_HOST=mail.highqualityltd.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@highqualityltd.com
SMTP_PASS=votre_mot_de_passe_email
MAIL_FROM="HIGH QUALITY Télécoms" <contact@highqualityltd.com>
MAIL_TO=contact@highqualityltd.com

# --------------------------------------------------------------
# ACCÈS BACK-OFFICE / ESPACE ADMINISTRATION (/admin)
# --------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=choisissez_un_mot_de_passe_long_et_unique
SESSION_SECRET=longue_chaine_aleatoire_a_generer
